<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DEBUG BUILDS ONLY: allow cleartext HTTP so the app can reach a LOCAL
         API Gateway (emulator host 10.0.2.2, or your PC's LAN IP on a physical
         device). Release/profile builds do NOT get this and stay HTTPS-only. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
